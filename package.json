{
  "name": "atoms-lite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "dev": "node --import tsx server/index.ts",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --packages=external --format=esm --outfile=dist/server.js",
    "start": "node dist/server.js",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts client/src/__tests__/*.test.ts"
  },
  "dependencies": {
    "acorn": "^8.15.0",
    "cheerio": "^1.1.2",
    "cookie": "^1.0.2",
    "drizzle-orm": "^0.44.5",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.14.5",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "esbuild": "^0.25.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-language-server": "5.0.0",
    "vite": "^7.1.3"
  }
}
